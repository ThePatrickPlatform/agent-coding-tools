{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|create|.*Jira.*|.*IssueLink.*|.*Worklog.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/jira-guard.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|.*createJiraIssue",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/jira-guard.mjs\"" }]
      }
    ]
  }
}
